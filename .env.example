# ============================================================================
#  Dalang AI settings. Copy this file to ".env" (same folder) and fill it in.
#  Never upload .env to GitHub (it is already in .gitignore).
#
#  THE ONE STEP TO GO LIVE: paste your Meta Model API key after META_API_KEY=
#  then run:   python scripts/check_keys.py
#  Without it the sample films still play, but new films are refused (GET /api/health says mode not_configured).
# ============================================================================

# --- Meta Model API (https://dev.meta.ai -> API keys). Meta's docs call it MODEL_API_KEY; either name works.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# --- Optional: open-weights bonus. Runs the script step on Muse Spark Open hosted by Baseten.
USE_OPEN_WEIGHTS=false
BASETEN_API_KEY=
# Meta's docs list the Baseten model id as meta-models/muse-spark-open. If your Baseten
# dashboard shows a dated id (for example meta-models/muse-spark-open-1026), paste it here.
OPEN_MODEL=meta-models/muse-spark-open
# Muse Glimmer (open weights, Apache 2.0): with USE_OPEN_WEIGHTS=true the safety screen and the title/moral
# polish run on it. Documented hosted provider: Together AI (key from api.together.xyz/settings/api-keys).
# Or a self-hosted OpenAI-compatible server: GLIMMER_API_BASE=http://localhost:8000/v1, GLIMMER_MODEL=muse-glimmer
GLIMMER_API_KEY=
GLIMMER_API_BASE=https://api.together.xyz/v1
GLIMMER_MODEL=meta-models/Muse-Glimmer-30B

# --- Behaviour
# DEMO_MODE=true: if a live run fails on stage, play the film made by scripts/demo_seed.py instead.
DEMO_MODE=false
# FAKE_META=true: the built-in fake Meta API answers every call (labelled placeholder art, free). For tests,
# CI and offline rehearsals only; it is never switched on just because the key is missing.
FAKE_META=false
# Most a single film may spend on Meta calls before it stops (USD). A normal film costs about $0.15-0.30.
JOB_BUDGET_USD=1.50
MAX_VERIFY_RETRIES=2
# Abuse limits for a public link (visits from this computer itself are never rate-limited).
RATE_LIMIT_PER_HOUR=12
# Proxies of yours in front of the API (0 = trust the first X-Forwarded-For address; 1 = only the last one, set it
# once you know the deploy chain, so typed fake addresses cannot get a fresh hourly bucket)
TRUSTED_PROXY_HOPS=0
MAX_ACTIVE_JOBS=6
MAX_STORY_CHARS=2000
MAX_AUDIO_SECONDS=120
# On start, delete private films nobody shared that are older than this many days (0 = keep everything).
CLEANUP_DAYS=0
# A story recording still on disk after this many hours (abandoned storyboard, crash) is deleted. 0 = off.
RECORDING_TTL_HOURS=6
# On start, copy the 3 sample films shipped in content/samples/ (made with the live Meta models) into the gallery.
BUNDLED_SAMPLES=true
# On start with FAKE_META=true, also make 3 placeholder-art samples (tests/offline only).
SEED_SAMPLES=false
# Logs: text (default) or json (one object per line, with request_id and job_id). Secrets are scrubbed.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Encode MP4s in this local folder first, then move them (for network filesystems where ffmpeg's trailer write fails).
ENCODE_DIR=
MAKE_VERTICAL=true
NARRATION_VOICE=true
# Narrator voice engine (no keys needed). auto (default): English on Kokoro-82M af_heart when it is installed,
# else edge-tts Emma Multilingual; Indonesian Emma Multilingual; Javanese Siti (see docs/VOICES.md).
# edge / kokoro / mms force one engine for every language it can speak (mms is non-commercial, CC-BY-NC-4.0).
TTS_ENGINE=auto
# Override one language as engine:voice[@speed], for example kokoro:am_michael or edge:en-GB-RyanNeural@-5.
# Empty = the auto choice above.
TTS_VOICE_EN=
TTS_VOICE_ID=
TTS_VOICE_JV=
# Python of a separate venv with requirements-tts.txt (Kokoro/MMS), so the app's own venv stays light.
# Empty = use Kokoro only if it is installed in this venv, otherwise edge-tts.
TTS_PYTHON=

# --- Where films are stored: local (default) or r2 (Cloudflare R2, S3-compatible; needs `pip install boto3`)
STORAGE_BACKEND=local
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET=
STORAGE_R2_PUBLIC_URL=

# --- Public address people open (your tunnel or host URL), used for share links, previews and QR codes.
# Until it is set, QR codes point at the labelled placeholder https://dalang-ai.example (not a real site).
PUBLIC_BASE_URL=
CORS_ORIGINS=*
DATA_DIR=
